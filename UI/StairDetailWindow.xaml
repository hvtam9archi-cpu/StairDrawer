<Window x:Class="StairDrawer.UI.StairDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trích chi tiết thang" Width="550" Height="760" MinWidth="520" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#181A1F" Foreground="#E8EAED"
        FontFamily="Segoe UI" FontSize="12" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="TextBox"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7,4"/><Setter Property="Background" Value="#2B2D32"/><Setter Property="Foreground" Value="#E8EAED"/><Setter Property="BorderBrush" Value="#454954"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EAED"/><Setter Property="Margin" Value="0,5,0,5"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="18,8"/><Setter Property="MinWidth" Value="90"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Trích chi tiết cấu tạo thang" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Margin="0,7,0,0" Foreground="#AEB5C0" Text="Sau khi xác nhận: chọn tâm vùng trích trên mặt cắt, rồi chọn vị trí đặt chi tiết."/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <RadioButton x:Name="StepsRadio" Content="Bậc thang (2–3 bậc)" Foreground="#E8EAED" IsChecked="True" Checked="OnKindChanged"/>
                    <RadioButton x:Name="NoseRadio" Content="Mũi bậc" Foreground="#E8EAED" Checked="OnKindChanged"/>
                </UniformGrid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Bán kính vùng trích (mm)"/><TextBox x:Name="RadiusText" Grid.Column="1" Text="450"/>
                </Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tỷ lệ mặt cắt gốc 1 :"/><TextBox x:Name="SourceScaleText" Grid.Column="1" Text="50" TextChanged="OnScaleChanged"/>
                </Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Tỷ lệ chi tiết 1 :"/><TextBox x:Name="DetailScaleText" Grid.Column="1" Text="10" TextChanged="OnScaleChanged"/>
                </Grid>
                <TextBlock x:Name="ScaleHint" Foreground="#93C5FD" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Số chi tiết / Số tờ"/><TextBox x:Name="NumberText" Grid.Column="1" Text="01" MaxLength="8"/><TextBox x:Name="SheetText" Grid.Column="3" MaxLength="30" ToolTip="Số tờ đặt trong ký hiệu tại nguồn; có thể để trống."/>
                </Grid>
                <TextBlock Text="Tên chi tiết" Margin="0,0,0,5"/><TextBox x:Name="TitleText" Text="CHI TIẾT BẬC THANG" MaxLength="100" Margin="0,0,0,10"/>
                <CheckBox x:Name="DimensionsCheck" Content="Dim chiều rộng mặt bậc và chiều cao cổ bậc" IsChecked="True" ToolTip="Vùng trích cần chứa ít nhất hai mặt bậc đá để tạo dim."/>
                <CheckBox x:Name="NotesCheck" Content="Ghi chú vật liệu" IsChecked="True"/>
                <StackPanel Margin="16,3,0,8">
                    <TextBox x:Name="TreadNoteText" Text="ĐÁ ỐP MẶT BẬC DÀY 20 MM" Margin="0,0,0,5" MaxLength="160" ToolTip="Ghi chú đá mặt bậc; để trống để bỏ ghi chú này."/>
                    <TextBox x:Name="RiserNoteText" Text="ĐÁ ỐP CỔ BẬC DÀY 20 MM" Margin="0,0,0,5" MaxLength="160" ToolTip="Ghi chú đá cổ bậc; để trống để bỏ ghi chú này."/>
                    <TextBox x:Name="BrickNoteText" Text="BẬC XÂY GẠCH ĐẶC, VỮA XI MĂNG" Margin="0,0,0,5" MaxLength="160" ToolTip="Ghi chú bậc xây gạch; để trống để bỏ ghi chú này."/>
                    <TextBox x:Name="ConcreteNoteText" Text="BẢN THANG BTCT ĐỔ TẠI CHỖ" MaxLength="160" ToolTip="Ghi chú bản thang bê tông; để trống để bỏ ghi chú này."/>
                </StackPanel>
                <CheckBox x:Name="HideRailingCheck" Content="Ẩn lan can trong hình chi tiết" IsChecked="True"/>
                <CheckBox x:Name="HorizontalCheck" Content="Đặt mặt bậc nằm ngang trên hình chi tiết" IsChecked="True"/>
                <CheckBox x:Name="LeaderCheck" Content="Vẽ đường nối từ vùng nguồn đến chi tiết (Callout)"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FCA5A5" Margin="0,10,0,10"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Trích chi tiết" IsDefault="True" Click="OnAccept" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
