<Window x:Class="StairDrawer.UI.StairConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StairDrawer"
        Width="980"
        Height="720"
        MinWidth="900"
        MinHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnWindowLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#181A1F" />
        <SolidColorBrush x:Key="TitleBrush" Color="#12141A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#2B2D32" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333640" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#3A3D45" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChoiceRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#444750" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="S" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               Text="StairDrawer · Cấu hình cầu thang"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="2"
                            Width="30"
                            Height="28"
                            Content="×"
                            FontSize="18"
                            ToolTip="Đóng"
                            Style="{StaticResource BaseButton}"
                            Padding="0"
                            Click="OnCloseClicked" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Loại bản vẽ" Style="{StaticResource SectionHeaderStyle}" />
                            <UniformGrid x:Name="DrawingTypePanel" Columns="2" Margin="0,0,0,16">
                                <RadioButton x:Name="PlanRadioButton"
                                             GroupName="DrawingMode"
                                             Content="Mặt bằng"
                                             IsChecked="True"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                                <RadioButton x:Name="SectionRadioButton"
                                             GroupName="DrawingMode"
                                             Content="Mặt cắt"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                            </UniformGrid>

                            <TextBlock Text="Loại thang" Style="{StaticResource SectionHeaderStyle}" />
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <RadioButton x:Name="StraightRadioButton"
                                             GroupName="StairType"
                                             Content="Thẳng"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                                <RadioButton x:Name="LShapeRadioButton"
                                             GroupName="StairType"
                                             Content="Chữ L"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                                <RadioButton x:Name="UShapeRadioButton"
                                             GroupName="StairType"
                                             Content="Chữ U"
                                             IsChecked="True"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                            </UniformGrid>

                            <TextBlock Text="Thông số chung (mm)" Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Chiều cao tầng" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="FloorHeightTextBox" Grid.Column="1" Text="3300" Style="{StaticResource DarkTextBox}" ToolTip="500–10000 mm" TextChanged="OnParameterTextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Tổng số cổ bậc" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TotalRisersTextBox" Grid.Column="1" Text="20" Style="{StaticResource DarkTextBox}" ToolTip="2–60; thang L/U tối thiểu 4" TextChanged="OnParameterTextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Chiều rộng mặt bậc" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TreadDepthTextBox" Grid.Column="1" Text="270" Style="{StaticResource DarkTextBox}" ToolTip="150–500 mm" />
                            </Grid>

                            <StackPanel x:Name="PlanFieldsPanel">
                                <TextBlock Text="Thông số mặt bằng (mm)" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều rộng vế thang" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="StairWidthTextBox" Grid.Column="1" Text="1000" Style="{StaticResource DarkTextBox}" ToolTip="600–5000 mm" />
                                </Grid>
                                <Grid x:Name="LandingDepthRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều sâu chiếu nghỉ" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="LandingDepthTextBox" Grid.Column="1" Text="1000" Style="{StaticResource DarkTextBox}" ToolTip="Không nhỏ hơn chiều rộng vế thang" />
                                </Grid>
                                <Grid x:Name="FlightGapRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Khe giữa hai vế" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FlightGapTextBox" Grid.Column="1" Text="100" Style="{StaticResource DarkTextBox}" ToolTip="0–1000 mm" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Cao độ mặt phẳng cắt" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="PlanCutHeightTextBox" Grid.Column="1" Text="1200" Style="{StaticResource DarkTextBox}" ToolTip="Lớn hơn 0 và nhỏ hơn chiều cao tầng" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="SectionFieldsPanel" Visibility="Collapsed">
                                <TextBlock Text="Thông số mặt cắt (mm)" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều dài chiếu nghỉ" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="LandingLengthTextBox" Grid.Column="1" Text="1000" Style="{StaticResource DarkTextBox}" ToolTip="600–5000 mm" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều dày bản BTCT" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SlabThicknessTextBox" Grid.Column="1" Text="120" Style="{StaticResource DarkTextBox}" ToolTip="80–500 mm" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều dày hoàn thiện" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FinishThicknessTextBox" Grid.Column="1" Text="20" Style="{StaticResource DarkTextBox}" ToolTip="1–100 mm" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Xem trước" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Grid.Column="1" Background="#1D4ED8" CornerRadius="10" Padding="9,3" Margin="0,0,0,8">
                                <TextBlock x:Name="PreviewModeBadge" Text="MẶT BẰNG · CHỮ U" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#1A1C21" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Viewbox Stretch="Uniform">
                                <Canvas x:Name="PreviewCanvas" Width="460" Height="280" ClipToBounds="True" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <TextBlock x:Name="PreviewTitleTextBlock" Text="Mặt bằng thang chữ U" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewDescriptionTextBlock"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Hai vế thang song song, nối qua chiếu nghỉ. Preview minh họa hướng và cấu trúc; hình CAD dùng đúng các thông số bên trái." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource TitleBrush}" CornerRadius="0,0,10,10">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Nhập thông số, xem preview rồi bấm Vẽ." />
                    <Button Grid.Column="1"
                            MinWidth="90"
                            Content="Hủy"
                            IsCancel="True"
                            Style="{StaticResource BaseButton}" />
                    <Button Grid.Column="3"
                            MinWidth="110"
                            Content="Vẽ"
                            IsDefault="True"
                            Style="{StaticResource AccentButton}"
                            Click="OnDrawClicked" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
