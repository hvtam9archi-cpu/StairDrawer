<Window x:Class="StairDrawer.UI.StairConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StairDrawer"
        Width="980"
        Height="720"
        MinWidth="900"
        MinHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnWindowLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#181A1F" />
        <SolidColorBrush x:Key="TitleBrush" Color="#12141A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#2B2D32" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333640" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#3A3D45" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="7"
                                      Data="M 1,3.5 L 4,6.5 L 9,0.5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#444750" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="5" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="S" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               Text="StairDrawer · Cấu hình cầu thang"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="2"
                            Width="30"
                            Height="28"
                            Content="×"
                            FontSize="18"
                            ToolTip="Đóng"
                            Style="{StaticResource BaseButton}"
                            Padding="0"
                            Click="OnCloseClicked" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Loại bản vẽ" Style="{StaticResource SectionHeaderStyle}" />
                            <UniformGrid x:Name="DrawingTypePanel" Columns="2" Margin="0,0,0,16">
                                <RadioButton x:Name="PlanRadioButton"
                                             GroupName="DrawingMode"
                                             Content="Mặt bằng"
                                             IsChecked="True"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                                <RadioButton x:Name="SectionRadioButton"
                                             GroupName="DrawingMode"
                                             Content="Mặt cắt"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                            </UniformGrid>

                            <TextBlock Text="Loại thang" Style="{StaticResource SectionHeaderStyle}" />
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <RadioButton x:Name="StraightRadioButton"
                                             GroupName="StairType"
                                             Content="Thẳng"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                                <RadioButton x:Name="LShapeRadioButton"
                                             GroupName="StairType"
                                             Content="Chữ L"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                                <RadioButton x:Name="UShapeRadioButton"
                                             GroupName="StairType"
                                             Content="Chữ U"
                                             IsChecked="True"
                                             Style="{StaticResource ChoiceRadioButton}"
                                             Checked="OnOptionChanged" />
                            </UniformGrid>

                            <CheckBox x:Name="StraightLandingCheckBox"
                                      Content="Thêm chiếu nghỉ cho thang thẳng"
                                      Margin="0,4,0,12"
                                      Visibility="Collapsed"
                                      Style="{StaticResource DarkCheckBox}"
                                      Checked="OnOptionChanged"
                                      Unchecked="OnOptionChanged" />

                            <TextBlock Text="Thông số chung (mm)" Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Chiều cao tầng" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="FloorHeightTextBox" Grid.Column="1" Text="3600" Style="{StaticResource DarkTextBox}" ToolTip="500–10000 mm" TextChanged="OnParameterTextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TotalRisersLabel" Text="Tổng số cổ bậc" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TotalRisersTextBox" Grid.Column="1" Text="20" Style="{StaticResource DarkTextBox}" ToolTip="2–60; thang L/U tối thiểu 4" TextChanged="OnParameterTextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Số cổ bậc vế 1 (A)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="FirstFlightRisersTextBox" Grid.Column="1" Text="10" Style="{StaticResource DarkTextBox}" ToolTip="Số cổ bậc vế trước chiếu nghỉ" TextChanged="OnFlightRisersTextChanged" />
                            </Grid>
                            <Grid x:Name="SecondFlightRisersRow" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SecondFlightRisersLabel" Text="Số cổ bậc vế 2 (B)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SecondFlightRisersTextBox" Grid.Column="1" Text="10" Style="{StaticResource DarkTextBox}" ToolTip="Số cổ bậc vế sau chiếu nghỉ" TextChanged="OnFlightRisersTextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Chiều rộng mặt bậc (C)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TreadDepthTextBox" Grid.Column="1" Text="250" Style="{StaticResource DarkTextBox}" ToolTip="150–500 mm" TextChanged="OnParameterTextChanged" />
                            </Grid>

                            <StackPanel x:Name="UTurnFieldsPanel" Visibility="Collapsed">
                                <TextBlock Text="Chiếu nghỉ thang chữ U" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Số mặt bậc vế giữa" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="MiddleFlightTreadsTextBox" Grid.Column="1" Text="0" Style="{StaticResource DarkTextBox}" ToolTip="0 để bỏ vế giữa. Khi có vế giữa, tính thêm một cổ bậc lên chiếu 2 và tự tính khe theo chiều chạy của vế." TextChanged="OnTurnStepsChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Số cổ bậc chéo chiếu 1" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FirstWinderRisersTextBox" Grid.Column="1" Text="0" Style="{StaticResource DarkTextBox}" ToolTip="Nhập 0 để chiếu 1 bằng phẳng." TextChanged="OnTurnStepsChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Số cổ bậc chéo chiếu 2" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SecondWinderRisersTextBox" Grid.Column="1" Text="0" Style="{StaticResource DarkTextBox}" ToolTip="Nhập 0 để chiếu 2 bằng phẳng." TextChanged="OnTurnStepsChanged" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PlanFieldsPanel">
                                <TextBlock x:Name="PlanFieldsHeader" Text="Thông số mặt bằng (mm)" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều rộng vế thang (D)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="StairWidthTextBox" Grid.Column="1" Text="1000" Style="{StaticResource DarkTextBox}" ToolTip="600–5000 mm" TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <Grid x:Name="LandingDepthRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LandingDepthLabel" Text="Chiều sâu chiếu nghỉ (E)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="LandingDepthTextBox" Grid.Column="1" Text="1000" Style="{StaticResource DarkTextBox}" ToolTip="Không nhỏ hơn chiều rộng vế thang" TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <Grid x:Name="FlightGapRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Khe giữa hai vế (F)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FlightGapTextBox" Grid.Column="1" Text="100" Style="{StaticResource DarkTextBox}" ToolTip="0–1000 mm" TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <Grid x:Name="PlanCutHeightRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Cao độ mặt phẳng cắt" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="PlanCutHeightTextBox" Grid.Column="1" Text="1200" Style="{StaticResource DarkTextBox}" ToolTip="Lớn hơn 0 và nhỏ hơn chiều cao tầng" TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <CheckBox x:Name="DrawPlanRailingCheckBox"
                                          Content="Vẽ lan can mặt bằng"
                                          Margin="0,6,0,10"
                                          Style="{StaticResource DarkCheckBox}"
                                          Checked="OnOptionChanged"
                                          Unchecked="OnOptionChanged" />
                            </StackPanel>

                            <StackPanel x:Name="SectionFieldsPanel" Visibility="Collapsed">
                                <TextBlock Text="Thông số mặt cắt (mm)" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid x:Name="SectionLandingLengthRow" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SectionLandingLengthLabel" Text="Chiều dài sàn tầng trên" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="LandingLengthTextBox" Grid.Column="1" Text="1000" Style="{StaticResource DarkTextBox}" ToolTip="600–5000 mm" TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều dày bản BTCT" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SlabThicknessTextBox" Grid.Column="1" Text="120" Style="{StaticResource DarkTextBox}" ToolTip="80–500 mm" TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Chiều dày đá ốp" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FinishThicknessTextBox" Grid.Column="1" Text="20" Style="{StaticResource DarkTextBox}" ToolTip="Đá ốp 1–100 mm. Vữa mặt bậc/sàn 20 mm; vữa cổ bậc 15 mm." TextChanged="OnParameterTextChanged" />
                                </Grid>
                                <CheckBox x:Name="DrawRailingCheckBox"
                                          Content="Vẽ lan can mặt cắt"
                                          Margin="0,6,0,10"
                                          Style="{StaticResource DarkCheckBox}"
                                          Checked="OnOptionChanged"
                                          Unchecked="OnOptionChanged" />
                            </StackPanel>
                                <StackPanel x:Name="RailingOptionsPanel" IsEnabled="False">
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <RadioButton x:Name="IronRailingRadioButton"
                                                     GroupName="RailingType"
                                                     Content="Lan can sắt"
                                                     IsChecked="True"
                                                     Style="{StaticResource ChoiceRadioButton}"
                                                     Checked="OnOptionChanged" />
                                        <RadioButton x:Name="GlassRailingRadioButton"
                                                     GroupName="RailingType"
                                                     Content="Lan can kính"
                                                     Style="{StaticResource ChoiceRadioButton}"
                                                     Checked="OnOptionChanged" />
                                    </UniformGrid>
                                    <StackPanel x:Name="GlassOptionsPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <RadioButton x:Name="GlassWithPostsRadioButton" GroupName="GlassConstruction" Content="Kính có trụ" IsChecked="True" Style="{StaticResource ChoiceRadioButton}" Checked="OnOptionChanged" />
                                            <RadioButton x:Name="FramelessGlassRadioButton" GroupName="GlassConstruction" Content="Kính không trụ" Style="{StaticResource ChoiceRadioButton}" Checked="OnOptionChanged" />
                                        </UniformGrid>
                                        <UniformGrid x:Name="GlassMountOptionsPanel" Columns="3" Margin="0,0,0,8" Visibility="Collapsed">
                                            <RadioButton x:Name="SinglePadRadioButton" GroupName="GlassMount" Content="Pad đơn" Style="{StaticResource ChoiceRadioButton}" Checked="OnOptionChanged" />
                                            <RadioButton x:Name="DoublePadRadioButton" GroupName="GlassMount" Content="Pad đôi" IsChecked="True" Style="{StaticResource ChoiceRadioButton}" Checked="OnOptionChanged" />
                                            <RadioButton x:Name="RecessedChannelRadioButton" GroupName="GlassMount" Content="Sập âm sàn" Style="{StaticResource ChoiceRadioButton}" Checked="OnOptionChanged" />
                                        </UniformGrid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Chiều dày kính" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="GlassThicknessTextBox" Grid.Column="1" Text="12" Style="{StaticResource DarkTextBox}" ToolTip="6–40 mm" TextChanged="OnParameterTextChanged" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Khe giữa các tấm kính" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="GlassPanelGapTextBox" Grid.Column="1" Text="10" Style="{StaticResource DarkTextBox}" ToolTip="5–50 mm" TextChanged="OnParameterTextChanged" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid x:Name="RailingHeightRow" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Chiều cao lan can (G)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="RailingHeightTextBox" Grid.Column="1" Text="900" Style="{StaticResource DarkTextBox}" ToolTip="600–1500 mm" TextChanged="OnParameterTextChanged" />
                                    </Grid>
                                </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Xem trước" Style="{StaticResource SectionHeaderStyle}" />
                            <CheckBox x:Name="ReverseSectionViewCheckBox" Grid.Column="1"
                                      Content="Đảo hướng nhìn" Margin="0,0,12,8"
                                      ToolTip="Đảo hướng nhìn mặt cắt A–A"
                                      Style="{StaticResource DarkCheckBox}"
                                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                            <Border Grid.Column="2" Background="#1D4ED8" CornerRadius="10" Padding="9,3" Margin="0,0,0,8">
                                <TextBlock x:Name="PreviewModeBadge" Text="MẶT BẰNG · CHỮ U" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#1A1C21" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                            <Canvas x:Name="PreviewCanvas" Background="Transparent" ClipToBounds="True"
                                    SizeChanged="OnPreviewSizeChanged" MouseLeftButtonDown="OnPreviewMouseDown"
                                    MouseMove="OnPreviewMouseMove" MouseLeftButtonUp="OnPreviewMouseUp"
                                    LostMouseCapture="OnPreviewLostMouseCapture">
                                <Canvas x:Name="PreviewGeometryCanvas"
                                        Width="{Binding ActualWidth, ElementName=PreviewCanvas}"
                                        Height="{Binding ActualHeight, ElementName=PreviewCanvas}"
                                        IsHitTestVisible="False" />

                            </Canvas>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource TitleBrush}" CornerRadius="0,0,10,10">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Nhập thông số, xem preview rồi bấm Vẽ." />
                    <Button x:Name="DrawDetailButton" Grid.Column="1" Content="Vẽ và trích" Visibility="Collapsed"
                            ToolTip="Vẽ mặt cắt và tự trích cả chi tiết bậc thang, mũi bậc; tự nhận vị trí và thông số."
                            Style="{StaticResource BaseButton}" Click="OnDrawDetailClicked" />
                    <Button Grid.Column="3"
                            MinWidth="90"
                            Content="Hủy"
                            IsCancel="True"
                            Style="{StaticResource BaseButton}" />
                    <Button Grid.Column="5"
                            MinWidth="110"
                            Content="Vẽ"
                            IsDefault="True"
                            Style="{StaticResource AccentButton}"
                            Click="OnDrawClicked" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
